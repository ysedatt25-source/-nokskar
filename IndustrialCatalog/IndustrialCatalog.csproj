<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UserSecretsId>IndustrialCatalog-Local-Admin</UserSecretsId>
    <BuildClientApp Condition="'$(BuildClientApp)' == ''">true</BuildClientApp>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="ClientApp/**"/>
    <None Remove="ClientApp/node_modules/**"/>
    <Compile Remove="ClientApp/**"/>
    <Content Update="seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="DetectNpm" BeforeTargets="BuildClientApp" Condition="'$(BuildClientApp)' == 'true'">
    <Exec Command="npm --version" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" IgnoreExitCode="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode"/>
    </Exec>
  </Target>
  <Target Name="BuildClientApp" BeforeTargets="PrepareForBuild" DependsOnTargets="DetectNpm" Condition="'$(BuildClientApp)' == 'true'">
    <!-- Clean Visual Studio packages include the verified compiled wwwroot output.
         Reuse it when Node/npm is unavailable; never publish a missing client. -->
    <Error Condition="'$(NpmExitCode)' != '0' and !Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')" Text="Node.js 22+ bulunamadı ve derlenmiş arayüz de mevcut değil. Yayın için önce istemciyi derleyin."/>
    <Message Condition="'$(NpmExitCode)' != '0' and Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')" Importance="high" Text="Node.js bulunamadı; paketteki hazır İnokskar arayüzü kullanılıyor."/>
    <Exec Condition="'$(NpmExitCode)' == '0'" Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp"/>
    <Exec Condition="'$(NpmExitCode)' == '0'" Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp"/>
  </Target>

  <Target Name="RefreshClientAssets" AfterTargets="BuildClientApp">
    <ItemGroup>
      <Content Remove="wwwroot/**"/>
      <Content Include="wwwroot/**" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
  </Target>
  <Target Name="EnsureClientAssets" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')" Text="Arayüz çıktısı bulunamadı. Önce ClientApp içinde npm run build çalıştırın."/>
  </Target>

  <Target Name="RemoveLegacyWindowsAppHost" BeforeTargets="PrepareForBuild">
    <Delete Files="$(OutputPath)$(AssemblyName).exe" Condition="'$(OutputPath)' != '' and Exists('$(OutputPath)$(AssemblyName).exe')"/>
    <Delete Files="$(TargetDir)$(AssemblyName).exe" Condition="'$(TargetDir)' != '' and Exists('$(TargetDir)$(AssemblyName).exe')"/>
  </Target>
</Project>
